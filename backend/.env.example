# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME
# ─────────────────────────────────────────────────────────────────────────────
# Railway injects PORT itself — do NOT set it there. This value is for local dev.
PORT=5000

# Set to `production` on Railway. It switches CORS to the allow-list only and
# stops the database config from falling back to localhost/root defaults.
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
# On Railway, link the MySQL service to the backend and reference its variables
# instead of copying credentials. Any ONE of these three forms works; they are
# read in this order of precedence:
#
#   1. DATABASE_URL / MYSQL_URL   e.g. ${{ MySQL.MYSQL_URL }}
#   2. MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
#   3. The DB_* variables below (local development)
#
# Never paste a literal password here for production — use Railway's
# ${{ MySQL.* }} references so the value stays in Railway's secret store.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=deliveryapp

# TLS to the database. Off by default (Railway's private network is isolated).
# DB_SSL=true
# DB_SSL_CA=

# The app was written against MariaDB's permissive sql_mode. This pins the same
# mode on MySQL 8, whose defaults (ONLY_FULL_GROUP_BY, STRICT_TRANS_TABLES)
# would otherwise reject aggregate queries that work locally.
# DB_SQL_MODE=NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — generate fresh values, never reuse the examples
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
# Separate secret used to encrypt stored payment credentials (32+ random characters recommended).
SETTINGS_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
# Rotation only: set the old key here, run `npm run migrate:waafi`, then remove it.
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated exact origins, no trailing slash. In production ONLY these are
# accepted; localhost is not implicitly allowed. Set this to your Vercel domain:
#   CORS_ORIGINS=https://your-app.vercel.app
# The Flutter apps are unaffected — native clients send no Origin header.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Allow every https://*.vercel.app preview deployment. Turn on only while
# testing previews; leave off for a locked-down production.
CORS_ALLOW_VERCEL_PREVIEWS=false

ADMIN_SUPPORT_PHONE=0613345902

# Required for secure initial-password delivery.
# Gmail requires a 16-character Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=replace-with-google-app-password
# Optional. If empty, SMTP_USER is used as the sender.
SMTP_FROM=Gaarsis App <your-gmail-address@gmail.com>

ADMIN_COMMISSION_RATE=2
DELIVERY_BASE_FEE=2
DELIVERY_PER_KM_FEE=0.5
ASSIGNMENT_RESPONSE_MINUTES=5
VENDOR_RESPONSE_MINUTES=5

# Hurmood/WAAFI API_PURCHASE merchant credentials.
# Customer phone is sent as payerInfo.accountNo; money goes to the selected vendor merchant.
# These legacy env values can be imported once with `npm run migrate:waafi`.
# New/updated credentials are managed per vendor in Admin > Settings > Payments.
HURMOOD_API_URL=https://api.waafipay.net/asm
HURMOOD_MERCHANT_UID=replace-with-merchant-uid
HURMOOD_API_USER_ID=replace-with-api-user-id
HURMOOD_API_KEY=replace-with-rotated-api-key
HURMOOD_VENDOR_ID=replace-with-default-vendor-id-that-owns-this-merchant
HURMOOD_TIMEOUT_MS=30000
