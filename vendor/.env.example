# ─── API Configuration (REQUIRED) ─────────────────────────────────────────────
#
# Local development:
#   VITE_API_URL=http://localhost:5001/api
#
# Production (Vercel → Project → Settings → Environment Variables):
#   VITE_API_URL=https://YOUR-RAILWAY-BACKEND-DOMAIN/api
#
# Must be https:// in production — the Vercel site is served over HTTPS and the
# browser blocks http:// requests from it as mixed content. Must keep the
# trailing /api and must NOT have a trailing slash.
#
# Vite inlines this at BUILD time, so changing it in Vercel requires a redeploy
# before the change takes effect.
VITE_API_URL=http://localhost:5001/api

# Vendor Web App Map Configurations

# To configure mapping providers in the Web app, copy this file to '.env'
# and define the keys you want to use.

# Option A: Mapbox Tiles (Recommended for dark theme matching)
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Option B: Google Maps Tiles
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourKeyHere

# Note: If no variables are set in the .env, the web app will fall back
# to the free CartoDB Dark Matter tile layer automatically.
